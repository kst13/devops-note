# 노드별로 이 파일을 .env 로 복사한 뒤 값을 바꾼다.
# 서버1: KAFKA_NODE_ID=1, ADVERTISED_HOST=10.0.0.11
# 서버2: KAFKA_NODE_ID=2, ADVERTISED_HOST=10.0.0.12
# 서버3: KAFKA_NODE_ID=3, ADVERTISED_HOST=10.0.0.13

# --- 노드별로 반드시 변경 ---
KAFKA_NODE_ID=1
ADVERTISED_HOST=10.0.0.11

# --- 3대 동일 (최초 1회 생성해 공유) ---
#   docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
CLUSTER_ID=REPLACE_WITH_GENERATED_UUID
