# 노드별로 이 파일을 .env 로 복사한 뒤 값을 바꾼다.
# 서버1: KAFKA_NODE_ID=1, ADVERTISED_HOST=10.0.0.11
# 서버2: KAFKA_NODE_ID=2, ADVERTISED_HOST=10.0.0.12
# 서버3: KAFKA_NODE_ID=3, ADVERTISED_HOST=10.0.0.13

# --- 노드별로 반드시 변경 ---
KAFKA_NODE_ID=1
ADVERTISED_HOST=10.0.0.11

# --- 3대 동일 (최초 1회 생성해 공유) ---
#   docker run --rm apache/kafka:4.0.0 /opt/kafka/bin/kafka-storage.sh random-uuid
CLUSTER_ID=REPLACE_WITH_GENERATED_UUID

# 호스트에서 데이터를 둘 최상위 디렉터리. 절대 경로(~ 사용 금지), 3대 동일 권장.
#   ${KAFKA_HOME_DIR}/data → 컨테이너 /var/lib/kafka/data (로그 세그먼트)
# 미리 만들고 UID 1000 소유로: sudo mkdir -p $KAFKA_HOME_DIR/data && sudo chown -R 1000:1000 $KAFKA_HOME_DIR
# 예) 서비스 계정 홈: /home/kafka/kafka, 전용 디스크: /data/kafka
KAFKA_HOME_DIR=/home/kafka/kafka
