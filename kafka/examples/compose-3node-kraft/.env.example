# 노드별로 이 파일을 .env 로 복사한 뒤, "노드별" 섹션 세 값만 노드에 맞게 바꾼다.
# 나머지(클러스터 ID, KAFKA_HOME_DIR, 시크릿)는 3대 동일하게 둔다.
# 서버1: KAFKA_NODE_ID=1, ADVERTISED_HOST/KEYSTORE 를 kafka1 값으로
# 서버2: KAFKA_NODE_ID=2, ... kafka2
# 서버3: KAFKA_NODE_ID=3, ... kafka3
#
# compose 외에 README/스크립트의 셸 명령도 이 파일을 읽어 쓴다:
#   set -a; . ./.env; set +a

# --- 노드별로 반드시 변경 ---
KAFKA_NODE_ID=1
ADVERTISED_HOST=10.0.0.11
KAFKA_KEYSTORE_FILE=kafka1.keystore.jks

# --- 3대 공통 (한 번 생성해 같은 값 사용) ---
# kafka-storage.sh random-uuid 로 생성. 스토리지 포맷과 기동 검증에 쓰인다.
KAFKA_CLUSTER_ID=__SET_ME__
# 호스트에서 데이터와 인증서를 둘 최상위 디렉터리. 절대 경로(~ 사용 금지), 3대 동일 권장.
#   ${KAFKA_HOME_DIR}/data   → 컨테이너 /var/lib/kafka/data (로그 세그먼트)
#   ${KAFKA_HOME_DIR}/secret → 컨테이너 /etc/kafka/secrets  (keystore/truststore, 읽기 전용)
# 미리 만들고 UID 1000 소유로: sudo mkdir -p $KAFKA_HOME_DIR/{data,secret} && sudo chown -R 1000:1000 $KAFKA_HOME_DIR
# 예) 서비스 계정 홈: /home/kafka/kafka, 전용 디스크: /data/kafka
KAFKA_HOME_DIR=/home/kafka/kafka

# --- 시크릿: 실제 운영에서는 파일에 두지 말고 Secret Manager/Vault 로 주입 ---
# (아래 값은 자리 표시용. 커밋 금지. .env 는 .gitignore 로 제외한다.)
KAFKA_KEYSTORE_PASSWORD=__SET_ME__
KAFKA_KEY_PASSWORD=__SET_ME__
KAFKA_TRUSTSTORE_PASSWORD=__SET_ME__

# 브로커 간 인증 계정 (스토리지 포맷 시 --add-scram 으로 만든 admin 계정)
KAFKA_INTER_BROKER_USER=admin
KAFKA_INTER_BROKER_PASSWORD=__SET_ME__
