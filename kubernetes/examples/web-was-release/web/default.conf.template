# nginx 공식 이미지가 기동 시 envsubst 로 ${...} 를 치환해 /etc/nginx/conf.d/default.conf 로 만든다.
# proxy_pass 에 변수를 쓰면 nginx 가 기동 시점이 아니라 요청 시점에 이름을 푼다.
# → was-order Service 가 아직 없어도 web 은 기동되고, /api 만 502 를 돌려준다.
server {
    listen 80;
    server_name _;

    # 클러스터 DNS(CoreDNS). 05-dns.envsh 가 /etc/resolv.conf 에서 읽어 넣는다.
    resolver ${DNS_SERVER} valid=10s ipv6=off;

    # 변수 proxy_pass 는 search 도메인을 붙이지 않으므로 FQDN 이어야 한다.
    set $was_upstream http://${WAS_HOST}:8080;

    location /api/ {
        proxy_pass $was_upstream;              # URI 는 그대로 전달 (/api/hello → WAS /api/hello)
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 2s;
    }

    location /healthz {
        return 200 'ok';
        add_header Content-Type text/plain;
    }

    location / {
        root /usr/share/nginx/html;
        try_files $uri $uri/ /index.html;
    }
}
