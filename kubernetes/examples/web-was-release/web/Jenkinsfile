// web-portal Job. 실서버에서는 web 저장소 루트에 둔다 (여기서는 샘플이라 web/ 아래라 dir('web') 이 있음).
// 하는 일: 이미지 빌드·push → 같은 버전으로 차트 패키지·push. 배포는 하지 않는다 (Rancher Apps 에서 선택).
pipeline {
  agent any
  environment {
    NEXUS_DOCKER = 'nexus.example.internal:5000'                          // docker hosted
    NEXUS_HELM   = 'http://nexus.example.internal:8081/repository/helm-hosted/'
    IMAGE        = "${NEXUS_DOCKER}/web-portal"
    VER          = "1.0.${env.BUILD_NUMBER}"                              // 이미지 태그 = 차트 버전. latest 금지
  }
  stages {
    stage('Build & push image') {
      steps {
        dir('web') {
          withCredentials([usernamePassword(credentialsId: 'nexus', usernameVariable: 'U', passwordVariable: 'P')]) {
            sh '''
              docker build --build-arg APP_VERSION=$VER -t $IMAGE:$VER .
              echo "$P" | docker login $NEXUS_DOCKER -u "$U" --password-stdin
              docker push $IMAGE:$VER
              docker logout $NEXUS_DOCKER
            '''
          }
        }
      }
    }
    stage('Package & push chart') {
      steps {
        dir('web') {
          withCredentials([usernamePassword(credentialsId: 'nexus', usernameVariable: 'U', passwordVariable: 'P')]) {
            sh '''
              helm lint chart
              helm package chart --version $VER --app-version $VER -d dist
              curl -fsS -u "$U:$P" --upload-file dist/web-portal-$VER.tgz $NEXUS_HELM
            '''
          }
        }
      }
    }
  }
  post {
    success { echo "web-portal ${VER} 준비 완료. Rancher → Apps → web-portal 에서 ${VER} 을 선택해 배포하세요." }
    always  { sh 'rm -rf web/dist; docker image rm -f $IMAGE:$VER || true' }
  }
}
